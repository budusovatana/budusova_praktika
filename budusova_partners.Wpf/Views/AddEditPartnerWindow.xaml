<Window x:Class="budusova_partners.Wpf.Views.AddEditPartnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:budusova_partners.Wpf.Views"
        mc:Ignorable="d"
        Height="450" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" >
        <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Stretch" >
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Название:"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Тип:"/>
                <ComboBox x:Name="TypeBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Рейтинг:"/>
                <TextBox x:Name="RatingBox"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Адрес:"/>
                <TextBox x:Name="AddressBox"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Директор:"/>
                <TextBox x:Name="DirectorBox"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Телефон:"/>
                <TextBox x:Name="PhoneBox"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5">
                <TextBlock Text="Email:"/>
                <TextBox x:Name="EmailBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Width="90" Margin="5" Click="Save_Click" Background="LightGreen"/>
                <Button Content="Отмена" Width="80" Margin="5" Click="Cancel_Click" Background="Red"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>